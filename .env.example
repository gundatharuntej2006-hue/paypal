# AgentGuard Gateway Configuration
PORT=8080
ENV=development

# Database (PostgreSQL URL, fallback to sqlite3 file or in-memory if empty)
DATABASE_URL=postgres://agentguard:agentguard@localhost:5432/agentguard?sslmode=disable
DB_DRIVER=sqlite3 # sqlite3 or postgres
SQLITE_DB_PATH=./agentguard.db

# Intelligence Service (Atul's FastAPI service)
INTEL_SERVICE_URL=http://localhost:8000
INTEL_TIMEOUT_MS=3000
INTEL_API_TOKEN=

# Internal Security & Ledger Webhook Token
INTERNAL_LEDGER_TOKEN=secret-gateway-token-123

# Decision Engine Policy Thresholds
RISK_THRESHOLD_BLOCK=0.65
RISK_THRESHOLD_STEPUP=0.35

# PayPal Sandbox Configuration
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
PAYPAL_MOCK_MODE=true # Set to false when using real PayPal sandbox credentials
