# Leave unset for a standalone stub run. Live mode defaults to http://localhost:8080.
VITE_GATEWAY_URL=
VITE_PAYPAL_CLIENT_ID=
VITE_USE_STUB=true

# auto prefers a published static report, then a configured gateway
VITE_BENCHMARK_SOURCE=auto
VITE_BENCHMARK_REPORT_URL=/benchmark-report.json

# Demo mode is always enabled with the browser stub.
VITE_DEMO_MODE=true
# Optional. Defaults to VITE_GATEWAY_URL + /v1/demo/run.
VITE_DEMO_RUN_URL=
