{
  "$defs": {
    "Factor": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "contribution": {
          "description": "How much this factor added to the score.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Contribution",
          "type": "number"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "contribution",
        "detail"
      ],
      "title": "Factor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Engine and prompt version that produced this result, e.g. 'stub' or 'scan_v1'.",
      "title": "Version",
      "type": "string"
    },
    "latency_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the result is unknown (e.g. 'timeout', 'no_llm_key'). Null otherwise.",
      "title": "Reason"
    },
    "status": {
      "enum": [
        "ok",
        "unknown"
      ],
      "title": "Status",
      "type": "string"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "0 = safest, 1 = riskiest. Null when status is unknown.",
      "title": "Score"
    },
    "factors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Factor"
      },
      "title": "Factors",
      "type": "array"
    }
  },
  "required": [
    "version",
    "status"
  ],
  "title": "RiskResponse",
  "type": "object"
}
