{
  "$defs": {
    "Influence": {
      "additionalProperties": false,
      "properties": {
        "reasoning_quote": {
          "maxLength": 500,
          "title": "Reasoning Quote",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        }
      },
      "required": [
        "reasoning_quote"
      ],
      "title": "Influence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Engine and prompt version that produced this result, e.g. 'stub' or 'scan_v1'.",
      "title": "Version",
      "type": "string"
    },
    "latency_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the result is unknown (e.g. 'timeout', 'no_llm_key'). Null otherwise.",
      "title": "Reason"
    },
    "verdict": {
      "enum": [
        "aligned",
        "misaligned",
        "unknown"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "rationale": {
      "maxLength": 1000,
      "title": "Rationale",
      "type": "string"
    },
    "influenced_by_external": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Influence"
      },
      "title": "Influenced By External",
      "type": "array"
    }
  },
  "required": [
    "version",
    "verdict",
    "confidence",
    "rationale"
  ],
  "title": "JudgeResponse",
  "type": "object"
}
